+def test_load_detected_corruption_remains_blocked_after_repair(tmp_path):
+    j=t.create(tmp_path);t.segment(j,stop_after=1)
+    head=(j.directory/'HEAD.json').read_bytes()
+    (j.directory/'HEAD.json').write_text('{}')
